# =============================================================================
# RetailIQ — Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Update the credentials below with your local or cloud environment settings.
# 3. NEVER commit your actual '.env' file to source control.
# =============================================================================

# Database Connection (PostgreSQL)
# On Render production, DATABASE_URL is automatically provided by the managed database.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retailiq_db

# Fallback individual parameters (used if DATABASE_URL is empty)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgresql_password_here
DB_NAME=retailiq_db

# FastAPI REST Engine Settings
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE="RetailIQ — Business Intelligence & Predictive Analytics Platform"
API_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=False

# Data & ML Paths
ML_MODELS_DIR=retailiq/ml/saved_models
DATA_DIR=retailiq/data/raw

# Frontend Integration & CORS
# On Render production, set FRONTEND_URL to your deployed frontend static site URL:
# FRONTEND_URL=https://retailiq-frontend.onrender.com
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8000
